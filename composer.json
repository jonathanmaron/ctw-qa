{
    "name": "ctw/ctw-qa",
    "description": "Configuration for commonly used quality assurance (QA) tools for PHP projects.",
    "license": "proprietary",
    "type": "library",
    "require": {
        "php": "^8.4",
        "icanhazstring/composer-unused": "^0.9.6",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "rector/rector": "^2.6.0",
        "shipmonk/composer-dependency-analyser": "^1.8.4",
        "symplify/easy-coding-standard": "^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "symfony/var-dumper": "^8.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Ctw\\Qa\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CtwTest\\Qa\\": "test"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "composer-dependency-analyser": "php vendor/bin/composer-dependency-analyser",
        "composer-unused": "php vendor/bin/composer-unused",
        "ecs": "php vendor/bin/ecs --clear-cache",
        "ecs-fix": "php vendor/bin/ecs --clear-cache --fix",
        "phpstan": "bash bin/phpstan.sh",
        "phpstan-baseline": "bash bin/phpstan-baseline.sh",
        "qa": [
            "@composer-dependency-analyser",
            "@composer-unused",
            "@rector",
            "@ecs",
            "@phpstan"
        ],
        "qa-fix": [
            "@composer-dependency-analyser",
            "@composer-unused",
            "@rector-fix",
            "@ecs-fix",
            "@phpstan"
        ],
        "rector": "php vendor/bin/rector process --clear-cache --dry-run",
        "rector-fix": "php vendor/bin/rector process --clear-cache",
        "test": "export XDEBUG_MODE=coverage ; php vendor/bin/phpunit"
    }
}
